# The server (FastAPI). On Render, e.g. https://strauss-car-advisor-api.onrender.com
# Local development on a real phone: the computer's address on the Wi-Fi, e.g. http://192.168.1.20:8000
# (and start the server with --host 0.0.0.0). "localhost" on the phone is the phone itself.
EXPO_PUBLIC_API_URL=

# Optional: the service email behind "talk to a rep" (default support@strauss-in.com)
EXPO_PUBLIC_SUPPORT_EMAIL=
