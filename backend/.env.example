# העתיקי לקובץ backend/.env ומלאי ערכים. את .env אסור להעלות ל-git (הוא ב-.gitignore).
# בחשבון החינמי, הקלט עשוי לשמש לאימון. לכן משתמשים רק בנתוני דוגמה.

# --- שלב 6: מודלים ---------------------------------------------------------

# ראשי: Gemini Flash. מוציאים מפתח בחינם ב-https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# גיבוי 1: Groq. עוברים אליו אוטומטית כשמגיעה שגיאה 429. מפתח: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# גיבוי 2: OpenRouter. מפתח: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- שלב 7: Supabase (אפשר להשאיר ריק בינתיים) -------------------------------

# Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# מפתח service_role. רק בשרת, לעולם לא בממשק.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (URI). משמש את PostgresSaver של LangGraph.
SUPABASE_DB_URL=
