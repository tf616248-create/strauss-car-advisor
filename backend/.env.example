# העתיקי לקובץ backend/.env ומלאי ערכים. את .env אסור להעלות ל-git (הוא ב-.gitignore).
# בחשבון החינמי, הקלט עשוי לשמש לאימון. לכן משתמשים רק בנתוני דוגמה.

# --- שלב 6: מודלים ---------------------------------------------------------

# ראשי: Gemini Flash. מוציאים מפתח בחינם ב-https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# מפתחות נוספים, כל אחד מפרויקט Google אחר (המכסה החינמית היא לכל פרויקט).
# כשמפתח מגיע למכסה (429), עוברים לבא בתור. אפשר עד GOOGLE_API_KEY_9.
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GEMINI_MODEL=gemini-3.7-flash

# גיבוי 1: Groq. עוברים אליו אוטומטית כשמגיעה שגיאה 429 או 503. מפתח: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# גיבוי 2: OpenRouter. מפתח: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- שלב 7: שרת ---------------------------------------------------------------

# סיסמה משותפת למסך הנציג. ריק = מסך הנציג סגור.
REP_PASSCODE=
# כתובות הממשק שמורשות לפנות לשרת, מופרדות בפסיק: הדומיין של Vercel והכתובת המקומית
# למשל: https://strauss-car-advisor.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# --- שלב 7: מסד נתונים (Neon) -------------------------------------------------

# ריק = הכול בזיכרון (לפיתוח ולבדיקות). השיחות ותור הנציג נמחקים כשהשרת עולה מחדש.
# Neon > Connect > Connection string. קודם כתובת ה-pooler (עם -pooler בשם השרת).
# אם PostgresSaver נכשל עם ה-pooler, עוברים לכתובת הישירה (בלי -pooler).
# כשהמשתנה מוגדר, גם בדיקות ה-contract של Postgres רצות מולו (על שיחות זמניות שנמחקות בסוף).
DATABASE_URL=
